{
  "name": "rss-mdm-agent",
  "private": true,
  "version": "0.1.3",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.14.1"
  },
  "scripts": {
    "dev": "pnpm --filter @rss-mdm-agent/desktop dev",
    "dev:web": "pnpm --filter @rss-mdm-agent/desktop dev:web",
    "build": "pnpm --filter @rss-mdm-agent/ui build && pnpm --filter @rss-mdm-agent/desktop build",
    "desktop:build": "pnpm --filter @rss-mdm-agent/desktop desktop:build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:boundaries": "node scripts/boundaries.mjs",
    "format:check": "prettier --check packages/ui/runtime.ts packages/ui/src packages/ui/tests apps/desktop/src scripts packages/ai-contract/src tests/ai-contract packages/ai-access/src packages/ai-client/src packages/ai-ui-bridge/src tests/ai-access packages/ai-adapters/claude/src tests/ai-adapters/claude packages/ai-store-sqlite/src tests/ai-store-recovery packages/ai-host/src apps/ai-host/src tests/ai-host packages/ai-adapters/codex/src tests/ai-adapters/codex packages/ai-adapters/deepseek/src tests/ai-adapters/deepseek tests/ai-provider-conformance tests/ai-recovery-integration tests/desktop packages/execution-bindings/src packages/platform-private-storage/src",
    "generate:ai-contract": "node scripts/generate-ai-contract.mjs",
    "check:ai-contract": "node scripts/generate-ai-contract.mjs --check",
    "build:ai-contract": "pnpm --filter @rss-mdm-agent/ai-contract build",
    "test:ai-contract": "node scripts/run-ai-tests.mjs --node tests/ai-contract",
    "build:ai-access": "pnpm --filter @rss-mdm-agent/ai-contract --filter @rss-mdm-agent/ai-access --filter @rss-mdm-agent/ai-client --filter @rss-mdm-agent/ai-ui-bridge --filter @rss-mdm-agent/execution-bindings build",
    "test:ai-access": "node scripts/run-ai-tests.mjs --node tests/ai-access",
    "check:ai-boundaries": "node --test scripts/ai-boundaries.test.mjs && node scripts/check-ai-boundaries.mjs",
    "build:ai-claude": "pnpm build:ai-contract && pnpm --filter @rss-mdm-agent/ai-adapter-claude build",
    "test:ai-claude": "node scripts/run-ai-tests.mjs tests/ai-adapters/claude",
    "smoke:claude": "node scripts/smoke-claude.mjs",
    "build:ai-store": "pnpm --filter @rss-mdm-agent/ai-store-sqlite... build",
    "test:ai-store": "node scripts/run-ai-tests.mjs tests/ai-store-recovery",
    "dev:assistant-fixture": "node tests/assistant/server.mjs --serve",
    "check:assistant": "node scripts/check-assistant-browser.mjs",
    "build:ai-deepseek": "pnpm build:ai-contract && pnpm --filter @rss-mdm-agent/ai-adapter-deepseek build",
    "test:ai-deepseek": "node scripts/run-ai-tests.mjs --node tests/ai-adapters/deepseek",
    "smoke:deepseek": "node scripts/smoke-deepseek.mjs",
    "generate:codex-protocol": "node scripts/generate-codex-protocol.mjs",
    "check:codex-protocol": "node scripts/generate-codex-protocol.mjs --check",
    "build:ai-codex": "pnpm build:ai-contract && pnpm --filter @rss-mdm-agent/ai-adapter-codex build",
    "test:ai-codex": "node scripts/run-ai-tests.mjs --node tests/ai-adapters/codex",
    "smoke:codex": "node scripts/smoke-codex.mjs",
    "build:ai-host": "node scripts/build-worker-runtime.mjs --build-host",
    "test:ai-host": "node scripts/run-ai-tests.mjs tests/ai-host",
    "bundle:ai-host": "node scripts/bundle-ai-host.mjs",
    "stage:desktop-runtime": "node scripts/stage-desktop-runtime.mjs",
    "check:desktop-bundle": "node scripts/check-desktop-bundle.mjs",
    "check:desktop-native": "node scripts/check-desktop-native.mjs",
    "test:ai-acceptance": "node scripts/check-ai-acceptance.mjs",
    "check:connection-sources": "node scripts/check-connection-sources.mjs",
    "build:installer": "node scripts/build-installers.mjs"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "js-yaml": "5.4.2",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.58.2",
    "prettier": "3.6.2",
    "typescript": "5.6.2",
    "vite": "6.4.3",
    "vitest": "3.2.4",
    "vue": "3.5.38",
    "vue-tsc": "2.1.10",
    "webdriverio": "9.32.0",
    "ajv": "8.20.0"
  },
  "type": "module"
}
