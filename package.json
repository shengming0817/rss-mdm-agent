{
  "name": "rss-mdm-agent",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @rss-mdm-agent/desktop dev",
    "dev:web": "pnpm --filter @rss-mdm-agent/desktop dev:web",
    "build": "pnpm --filter @rss-mdm-agent/ui build && pnpm --filter @rss-mdm-agent/desktop build",
    "desktop:build": "pnpm --filter @rss-mdm-agent/desktop desktop:build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "check:boundaries": "node --test scripts/boundaries.test.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "format:check": "prettier --check packages/ui/runtime.ts packages/ui/src packages/ui/tests apps/desktop/src scripts"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "5.2.1",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.10.6",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.6.2",
    "typescript": "5.6.2",
    "vite": "6.4.3",
    "vitest": "3.2.4",
    "vue": "3.5.38",
    "vue-tsc": "2.1.10"
  },
  "type": "module"
}
