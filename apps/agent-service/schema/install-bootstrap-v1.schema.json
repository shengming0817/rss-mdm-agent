{
  "$defs": {
    "GrantImport": {
      "additionalProperties": false,
      "description": "Administrator-protected bootstrap metadata; the secret is resolved separately by reference.",
      "properties": {
        "grant": {
          "$ref": "#/$defs/GrantReceipt",
          "description": "Server-issued grant."
        },
        "operationId": {
          "description": "Original grant creation operation, required for exact status recovery.",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "required": [
        "operationId",
        "grant"
      ],
      "type": "object"
    },
    "GrantReceipt": {
      "additionalProperties": false,
      "description": "Public progress; never includes the bootstrap secret.",
      "properties": {
        "expiresAt": {
          "description": "Original authorization deadline, Unix seconds.",
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        },
        "grantId": {
          "description": "Server-held request/grant identity.",
          "format": "uuid",
          "not": {
            "const": "00000000-0000-0000-0000-000000000000"
          },
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/TaskPlatform",
          "description": "Authorized platform."
        },
        "state": {
          "$ref": "#/$defs/GrantState",
          "description": "Current authorization state."
        },
        "wireVersion": {
          "const": 1,
          "description": "Enrollment API version."
        }
      },
      "required": [
        "wireVersion",
        "grantId",
        "state",
        "expiresAt",
        "platform"
      ],
      "type": "object"
    },
    "GrantState": {
      "description": "Persisted authorization lifecycle.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Waiting for an authenticated user to approve the exact client request.",
          "type": "string"
        },
        {
          "const": "available",
          "description": "Authorized and not yet consumed.",
          "type": "string"
        },
        {
          "const": "consumed",
          "description": "Bound to one certificate operation and public key.",
          "type": "string"
        },
        {
          "const": "revoked",
          "description": "Explicitly cancelled or revoked.",
          "type": "string"
        },
        {
          "const": "expired",
          "description": "Original authorization deadline has elapsed.",
          "type": "string"
        }
      ]
    },
    "Target": {
      "enum": [
        "windows-amd64",
        "windows-arm64",
        "macos-arm64"
      ],
      "type": "string"
    },
    "TaskPlatform": {
      "description": "Exact operating system of the selected immutable artifact.",
      "oneOf": [
        {
          "const": "windows",
          "description": "Windows.",
          "type": "string"
        },
        {
          "const": "macos",
          "description": "macOS.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:rss-mdm-agent:installation-bootstrap:1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grant": {
      "$ref": "#/$defs/GrantImport"
    },
    "installation_artifact": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "origin": {
      "maxLength": 2048,
      "pattern": "^https://",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "tenant": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    },
    "version": {
      "format": "uint8",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "origin",
    "tenant",
    "target",
    "installation_artifact",
    "grant"
  ],
  "title": "Bootstrap",
  "type": "object",
  "x-rss-enroll-schema-fingerprint": "d36d12d0bb958b8785f73273c4f8f10acf48cb3f52ea4804670efc79c0f093d4"
}
