{
  "name": "@rss-mdm-agent/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "pnpm --dir ../.. build:ai-access && pnpm --filter @rss-mdm-agent/ui build && vite --host 127.0.0.1",
    "build": "node ../../scripts/check-self-service-bindings.mjs && node ../../scripts/check-execution-bindings.mjs && vue-tsc --noEmit -p tsconfig.json && vite build",
    "desktop:build": "tauri build --no-bundle"
  },
  "dependencies": {
    "@rss-mdm-agent/ui": "workspace:*",
    "vue": "3.5.38",
    "@tauri-apps/api": "2.11.1",
    "@rss-mdm-agent/ai-client": "workspace:*",
    "@rss-mdm-agent/ai-ui-bridge": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@rss-mdm-agent/ai-contract": "workspace:*"
  }
}
