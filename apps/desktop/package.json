{
  "name": "@rss-mdm-agent/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node ../../scripts/desktop-dev.mjs",
    "dev:web": "pnpm --dir ../.. build:ai-access && pnpm --filter @rss-mdm-agent/ui build && vite --host 127.0.0.1",
    "build": "node ../../scripts/check-self-service-bindings.mjs && node ../../scripts/check-execution-bindings.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "desktop:build": "node ../../scripts/desktop-build.mjs"
  },
  "dependencies": {
    "@rss-mdm-agent/ui": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "@rss-mdm-agent/ai-client": "workspace:*",
    "@rss-mdm-agent/ai-ui-bridge": "workspace:*",
    "@rss-mdm-agent/ai-contract": "workspace:*",
    "@rss-mdm-agent/execution-bindings": "workspace:*",
    "@a2ui/web_core": "0.11.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "antd": "6.6.8",
    "@ant-design/icons": "6.3.4",
    "valtio": "2.3.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2"
  }
}
