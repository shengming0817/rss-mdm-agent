{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "node"],
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "packages/ui/src",
    "packages/ui/tests",
    "apps/desktop/src",
    "vitest.config.ts"
  ]
}
